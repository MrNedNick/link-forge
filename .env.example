# Where the app is reachable from the outside. Short links are built on top of
# this, so it must be the origin that actually serves the redirects.
PUBLIC_BASE_URL=http://localhost:8787

# Port the Hono server listens on.
PORT=8787

# Leave empty to use the embedded Postgres (PGlite) under ./.data/pglite —
# no daemon, no container, no setup. Set it to a connection string and the very
# same schema and migrations run against a real Postgres server instead.
# DATABASE_URL=postgres://user:password@localhost:5432/link_forge

# Set to 1 to make cookies Secure. Turn it on wherever you serve over HTTPS.
SECURE_COOKIES=0
